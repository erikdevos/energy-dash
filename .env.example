# Hostnaam of IP van je Chargee Sparky (Local API v1, poort 80). Leeg = mock-data.
# Vind hem via je router of mDNS (_chargee_p1._tcp), meestal sparky-<serienummer>.local
CHARGEE_HOST=
# Hoe vaak de server de meter uitleest
CHARGEE_POLL_SECONDS=10

# Adax Wi-Fi radiatoren (cloud). Maak een credential in de Adax-app onder Account, "Remote user client API".
# Leeg = geen Adax-koppeling. Deel deze waarden nooit en commit ze niet (.env staat in .gitignore).
ADAX_CLIENT_ID=
ADAX_CLIENT_SECRET=
