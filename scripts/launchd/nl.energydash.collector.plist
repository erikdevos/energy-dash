<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Laat de P1-collector altijd op de achtergrond draaien zolang je Mac aan staat (ook na herstart/inloggen).
  Installeren:   cp scripts/launchd/nl.energydash.collector.plist ~/Library/LaunchAgents/
                 launchctl load ~/Library/LaunchAgents/nl.energydash.collector.plist
  Stoppen:       launchctl unload ~/Library/LaunchAgents/nl.energydash.collector.plist
  Logbestand:    data/collector.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.energydash.collector</string>
  <key>WorkingDirectory</key>
  <string>/Users/familiedevos/Documents/erik/projects/energy-dash</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/familiedevos/.nvm/versions/node/v22.23.3/bin/node</string>
    <string>--env-file-if-exists=.env</string>
    <string>server/collect.ts</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/familiedevos/Documents/erik/projects/energy-dash/data/collector.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/familiedevos/Documents/erik/projects/energy-dash/data/collector.log</string>
</dict>
</plist>
